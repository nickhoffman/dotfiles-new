# Homebrew packages for both Macs, from the old repo's .homebrew_packages_to_install.
# Installed with `brew bundle --no-upgrade`: missing packages are added, nothing is
# upgraded or removed.
brew "zsh"
brew "wget"
brew "git"
brew "md5sha1sum"
brew "vim"
brew "ruby"
brew "asdf"
brew "node"
brew "yarn"
brew "reattach-to-user-namespace"
brew "tmux"
brew "tmuxp"
brew "powerlevel10k"
brew "rename"
brew "tree"
brew "prettier"
brew "libmagic"
brew "blueutil"
brew "pandoc"

# Mac apps. An app that's already in /Applications but wasn't installed by
# Homebrew is adopted instead of failing the install. That works whatever its
# version, because every one of these casks updates itself (auto_updates).
cask_args adopt: true
cask "alt-tab"
cask "handy"
cask "alfred"
cask "cleanshot"
cask "ghostty"
cask "rectangle"
cask "bartender"
