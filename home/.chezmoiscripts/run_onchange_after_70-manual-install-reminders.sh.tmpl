{{- /* Apps to install by hand. Runs last so its output isn't buried. */ -}}
{{- if and (eq .chezmoi.os "darwin") (eq .profile "personal") -}}
#!/bin/bash
# BetterTouchTool's developer recommends not installing it with Homebrew.
