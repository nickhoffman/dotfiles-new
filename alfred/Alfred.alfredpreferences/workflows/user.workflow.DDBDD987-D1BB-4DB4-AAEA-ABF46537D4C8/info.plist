				<string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Convert HTML cleanly without raw spans and format bold/italics
convert_html() {
  pandoc -f html -t commonmark-raw_html --wrap=none | \
    perl -pe '
      s/\*\*(.+?)\*\*/\x01$1\x01/g; # Temporarily mark bold
      s/\*(.+?)\*/_$1_/g;        # Change *italics* to _italics_
      s/\x01(.+?)\x01/*$1*/g;    # Change bold to *bold*
    '
}

HTML_DATA=$(osascript -e 'the clipboard as «class HTML»' 2&gt;/dev/null)

if [[ -n "$HTML_DATA" ]]; then
  echo "$HTML_DATA" | \
    perl -ne 'print chr foreach unpack("C*",pack("H*",substr($_,11,-3)))' | \
    convert_html
else
  RTF_DATA=$(osascript -e 'the clipboard as «class RTF »' 2&gt;/dev/null)
  if [[ -n "$RTF_DATA" ]]; then
    echo "$RTF_DATA" | \
      perl -ne 'print chr foreach unpack("C*",pack("H*",substr($_,10,-3)))' | \
      textutil -stdin -stdout -convert html | \
      convert_html
  else
    pbpaste
  fi
fi</string>
